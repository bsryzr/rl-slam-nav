<?xml version="1.0"?>
<robot name="depo_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Degiskenler -->
  <xacro:property name="govde_x" value="0.40"/>
  <xacro:property name="govde_y" value="0.30"/>
  <xacro:property name="govde_z" value="0.12"/>
  <xacro:property name="govde_m" value="3.0"/>
  <xacro:property name="teker_r" value="0.05"/>
  <xacro:property name="teker_w" value="0.04"/>
  <xacro:property name="teker_m" value="0.3"/>
  <xacro:property name="teker_ara" value="0.34"/>
  <xacro:property name="caster_r" value="0.025"/>
  <xacro:property name="caster_m" value="0.1"/>
  <xacro:property name="PI" value="3.14159"/>

  <!-- ATALET MAKROLARI - fizik motoru kutle ve donme direncini bilmeli -->
  <xacro:macro name="kutu_atalet" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m/12*(y*y+z*z)}" iyy="${m/12*(x*x+z*z)}" izz="${m/12*(x*x+y*y)}"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="silindir_atalet" params="m r h">
    <inertial>
      <origin rpy="${PI/2} 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${m/12*(3*r*r+h*h)}" iyy="${m/12*(3*r*r+h*h)}" izz="${m/2*r*r}"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="kure_atalet" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${2/5*m*r*r}" iyy="${2/5*m*r*r}" izz="${2/5*m*r*r}"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <!-- base_link - robotun referans noktasi -->
  <link name="base_link"/>

  <!-- Govde -->
  <link name="chassis">
    <visual>
      <geometry><box size="${govde_x} ${govde_y} ${govde_z}"/></geometry>
      <material name="turuncu"><color rgba="1 0.5 0 1"/></material>
    </visual>
    <collision>
      <geometry><box size="${govde_x} ${govde_y} ${govde_z}"/></geometry>
    </collision>
    <xacro:kutu_atalet m="${govde_m}" x="${govde_x}" y="${govde_y}" z="${govde_z}"/>
  </link>

  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin xyz="0 0 0.08"/>
  </joint>

  <!-- Teker makrosu -->
  <xacro:macro name="teker" params="isim y_yon">
    <link name="${isim}_teker">
      <visual>
        <origin rpy="${PI/2} 0 0"/>
        <geometry><cylinder radius="${teker_r}" length="${teker_w}"/></geometry>
        <material name="siyah"><color rgba="0.1 0.1 0.1 1"/></material>
      </visual>
      <collision>
        <origin rpy="${PI/2} 0 0"/>
        <geometry><cylinder radius="${teker_r}" length="${teker_w}"/></geometry>
      </collision>
      <xacro:silindir_atalet m="${teker_m}" r="${teker_r}" h="${teker_w}"/>
    </link>

    <joint name="${isim}_teker_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${isim}_teker"/>
      <origin xyz="0 ${y_yon * teker_ara / 2} ${teker_r}"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:teker isim="sol" y_yon="1"/>
  <xacro:teker isim="sag" y_yon="-1"/>

  <!-- Caster -->
  <link name="caster">
    <visual>
      <geometry><sphere radius="${caster_r}"/></geometry>
      <material name="gri"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
    <collision>
      <geometry><sphere radius="${caster_r}"/></geometry>
    </collision>
    <xacro:kure_atalet m="${caster_m}" r="${caster_r}"/>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster"/>
    <origin xyz="-0.15 0 ${caster_r}"/>
  </joint>

  <!-- Caster surtunmesiz kaysin, yoksa robotu frenler -->
  <gazebo reference="caster">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>


  <!-- GAZEBO EKLENTILERI -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>sol_teker_joint</left_joint>
      <right_joint>sag_teker_joint</right_joint>
      <wheel_separation>${teker_ara}</wheel_separation>
      <wheel_radius>${teker_r}</wheel_radius>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

</robot>
